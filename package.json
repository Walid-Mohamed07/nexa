{
    "name": "nexa-cafe-phase1",
    "private": true,
    "workspaces": [
        "web",
        "mock-api"
    ],
    "scripts": {
        "dev": "npm-run-all --parallel dev:web dev:mock",
        "dev:web": "npm --workspace web run dev",
        "dev:mock": "npm --workspace mock-api run dev",
        "test": "node --test",
        "build": "npm --workspace web run build",
        "start:web": "npm --workspace web run start",
        "start:mock": "npm --workspace mock-api run start"
    },
    "devDependencies": {
        "npm-run-all": "^4.1.5",
        "yaml": "^2.9.0"
    }
}
